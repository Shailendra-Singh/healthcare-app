# The Care Tasks frontend: serves the static app from /usr/share/nginx/html and passes everything else (/login,
# /logout, /api, the service APIs, Swagger UI) to the api-gateway. Page and API share one origin, so the gateway's
# Keycloak session cookie goes with every call and no CORS is needed.
#
# ${GATEWAY_URL} and ${NGINX_LOCAL_RESOLVERS} are filled in by the image's entrypoint when the container starts.

# Resolve the gateway on each request (it may restart with a new address) with the container's own DNS
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # The session cookie carries Keycloak's tokens and can be several KB
    large_client_header_buffers 4 32k;

    # Compress the app's files and the API's JSON (Pico's CSS goes from 83 KB to about 12 KB)
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / {
        rewrite ^ /index.html last;
    }

    # The app's files; any other path goes to the gateway
    location / {
        try_files $uri @gateway;

        # Alpine.js evaluates its x-* attributes with Function(), hence 'unsafe-eval'; no inline scripts or styles
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header Cache-Control no-cache always;
    }

    location @gateway {
        set $gateway ${GATEWAY_URL};
        proxy_pass $gateway;

        # The gateway builds Keycloak's redirect and logout URLs from the Host the browser used
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Room for the session cookie in the gateway's response headers
        proxy_buffer_size 32k;
        proxy_buffers 8 32k;
        proxy_busy_buffers_size 64k;
    }
}
