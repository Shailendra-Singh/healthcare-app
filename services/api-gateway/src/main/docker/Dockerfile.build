# syntax=docker/dockerfile:1
####
# Builds the application from source and runs it on the JVM, so the image needs no local JDK or Maven.
# The root compose.yaml uses it:
#
#   docker compose up --build        (from the repository root)
#
# For development, src/main/docker/Dockerfile.jvm packages a jar already built with ./mvnw package instead.
####

FROM docker.io/library/eclipse-temurin:21-jdk AS build
# The Maven wrapper verifies the .zip distribution it pins; without unzip it would fetch the .tar.gz and fail that check
RUN apt-get update && apt-get install -y --no-install-recommends unzip && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY .mvn .mvn
COPY mvnw pom.xml ./
COPY src src
# The Maven repository is cached between builds and shared by the services' builds; `locked` makes parallel builds
# take turns, so they don't download into it at the same time. Tests need Docker, so they run with ./mvnw test.
RUN --mount=type=cache,id=healthcare-maven,target=/root/.m2,sharing=locked ./mvnw -B -q package -DskipTests

FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24
ENV LANGUAGE='en_US:en'
COPY --from=build --chown=185 /build/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /build/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /build/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /build/target/quarkus-app/quarkus/ /deployments/quarkus/
EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
