# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Local database data (e.g. services/*/.data mounted by docker compose)
.data/

# Environment files with secrets, in any folder
.env
.env.*

# ETL input files (may contain patient data). The folder itself is kept via data/.gitkeep
/data/*
!/data/.gitkeep
