# Settings for the root compose.yaml (`docker compose up -d`). Copy to .env (cp env.template .env) and fill in.
# Database logins are created on the first start only (when ./.data/<service> is empty).

# --- clinical-data ---
CLINICAL_DB_USER=clinical_data_app
CLINICAL_DB_PASSWORD=change-me
# How often the ETL checks ./data for new CSVs, and how long a file must be unchanged before it is loaded
ETL_INTERVAL_SECONDS=300
ETL_FILE_SETTLE_SECONDS=30

# --- rules-engine ---
RULES_DB_USER=rules_engine_app
RULES_DB_PASSWORD=change-me
# Daily evaluation (Quartz cron: sec min hour day month weekday)
EVALUATION_CRON=0 0 6 * * ?
# The rules-engine also re-evaluates after each new successful ETL load; how often it checks for one
ETL_CHECK_EVERY=1m

# --- task-generation ---
TASK_DB_USER=task_generation_app
TASK_DB_PASSWORD=change-me
# How often task-generation checks the rules-engine for a new evaluation
TASK_POLL_EVERY=5m

# --- keycloak ---
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=change-me
# Keycloak admin console (http://localhost:8180/admin); not an app role
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Shared by Keycloak's api-gateway client and the gateway; 32+ random characters (it also encrypts the session cookie)
GATEWAY_CLIENT_SECRET=change-me-to-32-or-more-random-characters
# Passwords of the test users admin.user, scheduler.user and clinical.user
ADMIN_USER_PASSWORD=change-me
SCHEDULER_USER_PASSWORD=change-me
CLINICAL_USER_PASSWORD=change-me

# --- published ports on this machine ---
# The web app, the api-gateway (APIs, Swagger UI) and Keycloak (login pages, admin console).
# Keycloak's login return addresses follow FRONTEND_PORT and GATEWAY_PORT; to change those two after the first
# start, see "Changing ports later" in services/keycloak/README.md
FRONTEND_PORT=3000
GATEWAY_PORT=8080
KEYCLOAK_PORT=8180

# --- all services ---
# Time zone that decides "today" (ages, due dates, schedules)
TZ=UTC
